<!-- Layout personalizado del AlertDialog: imagen de la mascota + resumen de la solicitud.
     ScrollView para que el resumen se vea completo también en horizontal. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <!-- ImageView: imagen de la mascota elegida -->
        <ImageView
            android:id="@+id/ivDialogoMascota"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/desc_imagen_mascota" />

        <!-- TextView: resumen de todos los datos capturados -->
        <TextView
            android:id="@+id/tvDialogoResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/texto_principal"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
