<!-- Vista raíz: recibe como padding los insets de las barras del sistema. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/utesa_green"
    android:orientation="vertical">

    <!-- Barra superior en verde UTESA -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utesa_green"
        android:minHeight="56dp"
        app:title="@string/titulo_desarrolladores"
        app:titleTextColor="@color/white" />

    <!-- ScrollView: el contenido se puede desplazar en horizontal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TextView: título -->
            <TextView
                style="@style/Titulo"
                android:text="@string/titulo_desarrolladores" />

            <!-- TextView: nombre de la app -->
            <TextView
                style="@style/Etiqueta"
                android:text="@string/lbl_app" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <!-- TextView: asignatura -->
            <TextView
                style="@style/Etiqueta"
                android:text="@string/lbl_asignatura" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asignatura"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <!-- TextView: profesor -->
            <TextView
                style="@style/Etiqueta"
                android:text="@string/lbl_profesor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profesor"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <!-- TextView: encabezado de la tabla de integrantes -->
            <TextView
                style="@style/Etiqueta"
                android:layout_marginBottom="8dp"
                android:text="@string/lbl_integrantes" />

            <!-- TableLayout: integrantes con columnas Nombre y Matrícula -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/borde"
                android:padding="1dp"
                android:stretchColumns="0,1">

                <!-- Fila de encabezado -->
                <TableRow android:background="@color/utesa_green">

                    <TextView
                        style="@style/CeldaEncabezado"
                        android:text="@string/col_nombre" />

                    <TextView
                        style="@style/CeldaEncabezado"
                        android:text="@string/col_matricula" />
                </TableRow>

                <TableRow android:background="@color/fondo">

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev1_nombre" />

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev1_matricula" />
                </TableRow>

                <TableRow android:background="@color/utesa_green_claro">

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev2_nombre" />

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev2_matricula" />
                </TableRow>

                <TableRow android:background="@color/fondo">

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev3_nombre" />

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev3_matricula" />
                </TableRow>

                <TableRow android:background="@color/utesa_green_claro">

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev4_nombre" />

                    <TextView
                        style="@style/Celda"
                        android:text="@string/dev4_matricula" />
                </TableRow>
            </TableLayout>

            <!-- Button: regresa a la pantalla principal -->
            <Button
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_volver"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
