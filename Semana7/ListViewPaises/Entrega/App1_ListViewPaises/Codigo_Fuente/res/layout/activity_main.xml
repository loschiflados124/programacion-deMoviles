<!-- Vista raíz RelativeLayout (como en el documento). Recibe como padding los insets de
     las barras del sistema y de la cámara (ver MainActivity). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/utesa_green">

    <!-- Barra superior en verde UTESA (equivale a la ActionBar del documento) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/utesa_green"
        android:minHeight="56dp"
        app:titleTextColor="@color/white" />

    <!-- Zona de contenido con fondo blanco debajo de la barra -->
    <RelativeLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:background="@color/fondo"
        android:padding="16dp">

        <!-- "Large Text" del documento: muestra la población del país seleccionado -->
        <TextView
            android:id="@+id/tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:text="@string/seleccione_pais"
            android:textColor="@color/texto_principal"
            android:textSize="24sp" />

        <!-- Pie de pantalla con los integrantes del grupo -->
        <TextView
            android:id="@+id/tvDesarrollado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="8dp"
            android:background="@color/utesa_green_claro"
            android:gravity="center_horizontal"
            android:padding="8dp"
            android:text="@string/desarrollado_por"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp" />

        <!-- ListView con los países, entre tv1 y el pie de pantalla -->
        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/tvDesarrollado"
            android:layout_below="@id/tv1"
            android:layout_marginTop="8dp"
            android:divider="@color/divisor"
            android:dividerHeight="1dp" />
    </RelativeLayout>

</RelativeLayout>
